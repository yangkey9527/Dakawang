<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 列出全部已安装应用（Android 11+ 包可见性限制），供"从已安装应用选择"使用 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".DailyCheckinApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_pending"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round_pending"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyCheckin">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DailyCheckin" />

        <!-- 动态桌面图标：未全部完成（默认启用） -->
        <activity-alias
            android:name=".IconPending"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pending"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round_pending"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 动态桌面图标：今日全部完成（由 LauncherIconHelper 切换启用） -->
        <activity-alias
            android:name=".IconAllDone"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_done"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round_done"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".accessibility.CheckinAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
